# ─────────────────────────────────────────────────────────────────────────────
# UniverZAP — environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# Reference (upstream Chatwoot self-hosted vars):
# https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables/
#
# This file ships with values geared for a Coolify staging deploy on
# `staging.univerzap.cloud` with Cloudflare R2 + Mailgun. Override per-env.
# ─────────────────────────────────────────────────────────────────────────────

# ───── Installation / Branding ─────
INSTALLATION_NAME=UniverZAP
DEFAULT_LOCALE=pt_BR

# Disable the upstream Chatwoot enterprise overlay (license-restricted).
# Keep set to true unless you have a Chatwoot Enterprise subscription.
DISABLE_ENTERPRISE=true

# ───── Secrets ─────
# Generate with: bundle exec rails secret
SECRET_KEY_BASE=replace_with_lengthy_secure_hex

# Required for MFA/2FA. Generate with: rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ───── URL / SSL ─────
FRONTEND_URL=https://staging.univerzap.cloud
HELPCENTER_URL=https://staging.univerzap.cloud
FORCE_SSL=true
ASSET_CDN_HOST=

# ───── Signup ─────
# true | false | api_only
ENABLE_ACCOUNT_SIGNUP=false

# ───── Rails ─────
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
LOG_SIZE=500
RAILS_MAX_THREADS=10

# ───── PostgreSQL ─────
# Inside docker-compose: host = postgres (service name).
# Coolify: point at the managed Postgres service.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=univerzap_production
POSTGRES_USERNAME=univerzap
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_STATEMENT_TIMEOUT=14s

# ───── Redis ─────
REDIS_URL=redis://:replace_with_strong_password@redis:6379
REDIS_PASSWORD=replace_with_strong_password
# REDIS_OPENSSL_VERIFY_MODE=none
# REDIS_SENTINELS=
# REDIS_SENTINEL_MASTER_NAME=

# ───── Sidekiq ─────
SIDEKIQ_CONCURRENCY=10
ENABLE_SIDEKIQ_DEQUEUE_LOGGER=false

# ───── Mail (Mailgun) ─────
MAILER_SENDER_EMAIL=UniverZAP <noreply@univerzap.cloud>
SMTP_DOMAIN=univerzap.cloud
SMTP_ADDRESS=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@mg.univerzap.cloud
SMTP_PASSWORD=replace_with_mailgun_smtp_password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# ───── Inbound email (Mailgun route) ─────
MAILER_INBOUND_EMAIL_DOMAIN=mg.univerzap.cloud
RAILS_INBOUND_EMAIL_SERVICE=mailgun
RAILS_INBOUND_EMAIL_PASSWORD=replace_with_strong_password
MAILGUN_INGRESS_SIGNING_KEY=replace_with_mailgun_webhook_signing_key

# ───── Storage ─────
# Default: local disk on the VPS (the `storage_data` named volume in compose).
# Fine for MVP and small tenants. Switch to `cloudflare` (R2) once attachment
# usage grows past ~50GB or you scale to multiple app nodes.
ACTIVE_STORAGE_SERVICE=local
DIRECT_UPLOADS_ENABLED=false

# Uncomment + fill to switch to Cloudflare R2 (S3-compatible, $0 egress):
# ACTIVE_STORAGE_SERVICE=cloudflare
# STORAGE_BUCKET_NAME=univerzap-staging-attachments
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# DIRECT_UPLOADS_ENABLED=true

# ───── Push relay ─────
# false in production so notifications stay on our infra (not Chatwoot cloud).
ENABLE_PUSH_RELAY_SERVER=false

# Generate at https://d3v.one/vapid-key-generator/
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ───── Error monitoring ─────
SENTRY_DSN=

# ───── Rack Attack ─────
ENABLE_RACK_ATTACK=true
RACK_ATTACK_LIMIT=300
ENABLE_RACK_ATTACK_WIDGET_API=true
# RACK_ATTACK_ALLOWED_IPS=

# ───── Social / channel integrations (fill as you enable them) ─────
# Facebook
FB_VERIFY_TOKEN=
FB_APP_SECRET=
FB_APP_ID=

# Instagram
IG_VERIFY_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# WhatsApp Cloud API (Meta)
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_CONFIGURATION_ID=

# WhatsApp via WAHA (unofficial / QR-code provider)
# WAHA_BASE_URL=https://whatsapp.univerzap.cloud
# WAHA_API_KEY=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=

# Microsoft OAuth
AZURE_APP_ID=
AZURE_APP_SECRET=

# ───── AI features ─────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ───── Mobile app identifiers ─────
# Leave defaults unless you're shipping a custom-branded mobile app.
IOS_APP_ID=L7YLMN4634.com.chatwoot.app
ANDROID_BUNDLE_ID=com.chatwoot.app
ANDROID_SHA256_CERT_FINGERPRINT=AC:73:8E:DE:EB:56:EA:CC:10:87:02:A7:65:37:7B:38:D4:5D:D4:53:F8:3B:FB:D3:C6:28:64:1D:AA:08:1E:D8

# ───── Univercart Connect (subscription billing) ─────
UNIVERCART_API_BASE=https://api.univercart.com
UNIVERCART_API_KEY=
UNIVERCART_WEBHOOK_SECRET=
UNIVERCART_JWT_SECRET=
UNIVERCART_PARTNER_SLUG=univerzap
