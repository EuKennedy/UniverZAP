<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="index, follow" />
  <meta name="legal:version" content="<%= @version %>" />
  <title><%= @page_title %> · UniverZAP</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", "Inter", system-ui, sans-serif;
      background: #0a0f0e;
      color: #f1f5f4;
      line-height: 1.6;
      letter-spacing: -0.005em;
    }
    .wrap { max-width: 760px; margin: 0 auto; padding: 56px 24px 96px; }
    .brand {
      display: inline-flex; align-items: center; gap: 10px;
      margin-bottom: 32px;
      color: #5eead4; font-size: 13px; font-weight: 600;
      letter-spacing: 0.12em; text-transform: uppercase;
    }
    .brand::before {
      content: ''; width: 8px; height: 8px; border-radius: 50%;
      background: #14b8a6; box-shadow: 0 0 12px rgba(20, 184, 166, 0.6);
    }
    h1 { font-size: 32px; margin: 0 0 6px; letter-spacing: -0.025em; font-weight: 600; }
    .meta { font-size: 12px; color: #64748b; margin-bottom: 40px; }
    h2 { font-size: 18px; margin: 32px 0 12px; font-weight: 600; color: #f1f5f4; letter-spacing: -0.015em; }
    h3 { font-size: 14px; margin: 20px 0 8px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.08em; }
    p, li { font-size: 14px; color: #cbd5e1; }
    a { color: #5eead4; text-decoration: underline; text-underline-offset: 3px; }
    .changelog {
      margin-top: 56px; padding-top: 24px;
      border-top: 1px solid rgba(148, 163, 184, 0.14);
    }
    .changelog li { margin-bottom: 6px; }
    ul, ol { padding-left: 20px; }
    code {
      background: rgba(20, 184, 166, 0.12);
      color: #5eead4;
      padding: 1px 6px; border-radius: 4px;
      font-size: 12px;
    }
    footer {
      margin-top: 80px; padding-top: 24px;
      border-top: 1px solid rgba(148, 163, 184, 0.14);
      font-size: 12px; color: #64748b;
    }
    footer a { color: #94a3b8; }
  </style>
</head>
<body>
  <main class="wrap">
    <span class="brand">UniverZAP</span>
    <%= yield %>
    <footer>
      <p>
        UniverZAP é operado por UniverBeauty / UniverZap.
        Canal LGPD/DPO: <a href="mailto:privacidade@univerbeauty.com.br">privacidade@univerbeauty.com.br</a> ·
        Suporte: <a href="mailto:suporte@univerbeauty.com.br">suporte@univerbeauty.com.br</a>
      </p>
      <p>
        <a href="/termos">Termos de Uso</a> · <a href="/privacidade">Política de Privacidade</a>
      </p>
    </footer>
  </main>
</body>
</html>
