<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="index, follow" />
  <meta name="docs:version" content="<%= @version %>" />
  <title>Documentação · UniverZAP</title>
  <style>
    :root {
      --bg: #0a0f0e;
      --bg-soft: #0e1514;
      --panel: #0f1716;
      --border: rgba(148, 163, 184, 0.14);
      --border-strong: rgba(148, 163, 184, 0.24);
      --text: #f1f5f4;
      --text-soft: #cbd5e1;
      --muted: #64748b;
      --muted-2: #94a3b8;
      --brand: #13CB8D;
      --brand-soft: #60E8B8;
      --brand-dim: rgba(19, 203, 141, 0.12);
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", "Inter", system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.65;
      letter-spacing: -0.005em;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--brand-soft); text-decoration: none; }
    a:hover { text-decoration: underline; text-underline-offset: 3px; }

    /* Top bar */
    .topbar {
      position: sticky; top: 0; z-index: 40;
      display: flex; align-items: center; gap: 16px;
      padding: 14px 24px;
      background: rgba(10, 15, 14, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }
    .brand {
      display: inline-flex; align-items: center; gap: 10px;
      color: var(--text); font-size: 15px; font-weight: 700;
      letter-spacing: -0.01em;
    }
    .brand::before {
      content: ''; width: 9px; height: 9px; border-radius: 50%;
      background: var(--brand); box-shadow: 0 0 12px rgba(19, 203, 141, 0.7);
    }
    .badge {
      font-size: 11px; font-weight: 600; color: var(--brand-soft);
      background: var(--brand-dim); border: 1px solid rgba(19,203,141,0.25);
      padding: 2px 8px; border-radius: 999px; letter-spacing: 0.02em;
    }
    .topbar .spacer { flex: 1; }
    .search {
      position: relative; width: 280px; max-width: 40vw;
    }
    .search input {
      width: 100%; padding: 8px 12px 8px 34px;
      background: var(--panel); color: var(--text);
      border: 1px solid var(--border); border-radius: 10px;
      font-size: 13px; outline: none;
    }
    .search input:focus { border-color: rgba(19,203,141,0.45); }
    .search svg { position: absolute; left: 11px; top: 9px; width: 15px; height: 15px; color: var(--muted-2); }
    .topbar a.app-link {
      font-size: 13px; font-weight: 600; color: var(--text);
      padding: 8px 14px; border-radius: 10px;
      border: 1px solid var(--border-strong);
    }
    .topbar a.app-link:hover { border-color: var(--brand); text-decoration: none; }
    .menu-btn {
      display: none; background: var(--panel); border: 1px solid var(--border);
      color: var(--text); border-radius: 9px; padding: 7px 10px; cursor: pointer;
    }

    /* Layout */
    .layout { display: grid; grid-template-columns: 264px minmax(0, 1fr); max-width: 1240px; margin: 0 auto; }
    .sidebar {
      position: sticky; top: 57px; align-self: start;
      height: calc(100vh - 57px); overflow-y: auto;
      padding: 28px 16px 64px; border-right: 1px solid var(--border);
    }
    .nav-group { margin-bottom: 22px; }
    .nav-eyebrow {
      font-size: 11px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.1em; color: var(--muted); margin: 0 0 8px 10px;
    }
    .nav a {
      display: block; padding: 6px 10px; border-radius: 8px;
      font-size: 13.5px; color: var(--muted-2); margin-bottom: 1px;
      border-left: 2px solid transparent;
    }
    .nav a:hover { color: var(--text); background: rgba(148,163,184,0.06); text-decoration: none; }
    .nav a.active {
      color: var(--brand-soft); background: var(--brand-dim);
      border-left-color: var(--brand); font-weight: 600;
    }
    .nav a.hidden { display: none; }
    .nav-empty { font-size: 12.5px; color: var(--muted); padding: 6px 10px; display: none; }

    /* Content */
    .content { padding: 48px 40px 120px; max-width: 820px; }
    .hero {
      padding: 32px; border-radius: 18px; margin-bottom: 48px;
      background:
        radial-gradient(120% 140% at 0% 0%, rgba(19,203,141,0.16), transparent 55%),
        linear-gradient(180deg, var(--bg-soft), var(--bg));
      border: 1px solid var(--border);
    }
    .hero .eyebrow { color: var(--brand-soft); font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
    .hero h1 { font-size: 38px; line-height: 1.1; margin: 12px 0 10px; letter-spacing: -0.03em; font-weight: 700; }
    .hero p { font-size: 16px; color: var(--text-soft); margin: 0; max-width: 60ch; }

    section { scroll-margin-top: 80px; padding-top: 8px; margin-bottom: 14px; }
    h2 {
      font-size: 24px; margin: 44px 0 14px; font-weight: 700;
      letter-spacing: -0.02em; padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }
    h3 { font-size: 16px; margin: 28px 0 10px; font-weight: 650; color: var(--text); letter-spacing: -0.01em; }
    p, li { font-size: 14.5px; color: var(--text-soft); }
    ul, ol { padding-left: 22px; }
    li { margin-bottom: 6px; }
    strong { color: var(--text); font-weight: 650; }
    code {
      background: var(--brand-dim); color: var(--brand-soft);
      padding: 1px 6px; border-radius: 5px; font-size: 12.5px;
      font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
    }
    pre {
      background: var(--panel); border: 1px solid var(--border);
      border-radius: 12px; padding: 16px 18px; overflow-x: auto; margin: 16px 0;
    }
    pre code { background: none; color: var(--text-soft); padding: 0; font-size: 12.5px; line-height: 1.7; }

    .grid-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin: 20px 0; }
    .card {
      padding: 18px; border-radius: 14px; background: var(--bg-soft);
      border: 1px solid var(--border);
    }
    .card h4 { margin: 0 0 6px; font-size: 14px; color: var(--text); font-weight: 650; }
    .card p { margin: 0; font-size: 13px; color: var(--muted-2); }

    .callout {
      margin: 18px 0; padding: 14px 16px; border-radius: 12px;
      border: 1px solid var(--border); background: var(--bg-soft);
      font-size: 13.5px; display: flex; gap: 12px;
    }
    .callout .ic { flex-shrink: 0; font-size: 15px; line-height: 1.5; }
    .callout p { margin: 0; }
    .callout.tip { border-color: rgba(19,203,141,0.3); background: var(--brand-dim); }
    .callout.warn { border-color: rgba(245, 158, 11, 0.32); background: rgba(245, 158, 11, 0.08); }
    .callout.note { border-color: var(--border-strong); }

    table { width: 100%; border-collapse: collapse; margin: 18px 0; font-size: 13.5px; }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); }
    th { color: var(--muted-2); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
    td { color: var(--text-soft); }

    .steps { counter-reset: step; list-style: none; padding-left: 0; }
    .steps li { position: relative; padding-left: 40px; margin-bottom: 16px; }
    .steps li::before {
      counter-increment: step; content: counter(step);
      position: absolute; left: 0; top: 0;
      width: 26px; height: 26px; border-radius: 50%;
      background: var(--brand-dim); color: var(--brand-soft);
      border: 1px solid rgba(19,203,141,0.3);
      display: grid; place-content: center; font-size: 13px; font-weight: 700;
    }

    footer {
      margin-top: 72px; padding-top: 24px;
      border-top: 1px solid var(--border);
      font-size: 12.5px; color: var(--muted);
    }
    footer a { color: var(--muted-2); }

    @media (max-width: 860px) {
      .layout { grid-template-columns: 1fr; }
      .sidebar {
        position: fixed; top: 57px; left: 0; z-index: 35;
        width: 280px; max-width: 84vw; height: calc(100vh - 57px);
        background: var(--bg); transform: translateX(-110%);
        transition: transform 0.22s ease; border-right: 1px solid var(--border);
      }
      .sidebar.open { transform: translateX(0); box-shadow: 0 24px 60px rgba(0,0,0,0.5); }
      .menu-btn { display: inline-flex; }
      .content { padding: 32px 22px 96px; }
      .search { width: 180px; }
      .topbar a.app-link { display: none; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <button class="menu-btn" id="menuBtn" aria-label="Abrir menu">☰</button>
    <span class="brand">UniverZAP</span>
    <span class="badge">Docs · v<%= @version %></span>
    <span class="spacer"></span>
    <div class="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="docSearch" type="search" placeholder="Buscar na documentação…" autocomplete="off" />
    </div>
    <a class="app-link" href="/app">Abrir plataforma →</a>
  </header>

  <div class="layout">
    <aside class="sidebar" id="sidebar">
      <nav class="nav" id="nav">
        <div class="nav-group">
          <p class="nav-eyebrow">Começar</p>
          <a href="#introducao">Introdução</a>
          <a href="#primeiros-passos">Primeiros passos</a>
          <a href="#conceitos">Conceitos-chave</a>
        </div>
        <div class="nav-group">
          <p class="nav-eyebrow">Atendimento</p>
          <a href="#inbox">Caixa de entrada</a>
          <a href="#whatsapp">WhatsApp</a>
          <a href="#contatos">Contatos</a>
        </div>
        <div class="nav-group">
          <p class="nav-eyebrow">Automação</p>
          <a href="#chatflow">Chatflow</a>
          <a href="#athenas">Agente de IA</a>
          <a href="#campanhas">Campanhas</a>
        </div>
        <div class="nav-group">
          <p class="nav-eyebrow">Gestão</p>
          <a href="#kanban">Funis Kanban</a>
          <a href="#tarefas">Tarefas</a>
          <a href="#metas">Metas</a>
          <a href="#relatorios">Relatórios</a>
        </div>
        <div class="nav-group">
          <p class="nav-eyebrow">Guias</p>
          <a href="#guia-primeiro-bot">Montar seu 1º bot</a>
          <a href="#guia-funil">Criar um funil de vendas</a>
        </div>
        <div class="nav-group">
          <p class="nav-eyebrow">Referência</p>
          <a href="#api">API &amp; Webhooks</a>
          <a href="#seguranca">Segurança &amp; LGPD</a>
          <a href="#versoes">Versões</a>
          <a href="#faq">FAQ</a>
          <a href="#suporte">Suporte</a>
        </div>
        <p class="nav-empty" id="navEmpty">Nenhum resultado.</p>
      </nav>
    </aside>

    <main class="content">
      <div class="hero">
        <p class="eyebrow">Documentação</p>
        <h1>Tudo sobre o UniverZAP</h1>
        <p>Plataforma de atendimento, automação e vendas via WhatsApp, Instagram, e-mail e web, com fluxos inteligentes, Agente de IA, funis Kanban e metas. Esta é a referência completa do produto.</p>
      </div>

      <section id="introducao">
        <h2>Introdução</h2>
        <p>O <strong>UniverZAP</strong> centraliza todas as conversas dos seus canais em uma única caixa de entrada, automatiza atendimento com fluxos e IA, organiza oportunidades em funis e mede resultados com metas e relatórios. É multi-tenant, dark-first e construído para escala.</p>
        <div class="grid-cards">
          <div class="card"><h4>Omnichannel</h4><p>WhatsApp, Instagram, e-mail e formulários web em um só lugar.</p></div>
          <div class="card"><h4>Automação</h4><p>Chatflow visual + agentes de IA com base de conhecimento.</p></div>
          <div class="card"><h4>Vendas</h4><p>Funis Kanban, tarefas, metas e campanhas de disparo.</p></div>
          <div class="card"><h4>Inteligência</h4><p>Relatórios, copiloto e onboarding guiado.</p></div>
        </div>
      </section>

      <section id="primeiros-passos">
        <h2>Primeiros passos</h2>
        <p>Do zero ao primeiro atendimento em minutos.</p>
        <ol class="steps">
          <li><strong>Acesse a plataforma</strong> em <a href="/app">app.univerzap.cloud/app</a> e entre com seu e-mail (magic link) ou senha.</li>
          <li><strong>Conecte sua primeira caixa de entrada</strong> em <code>Configurações → Caixas de entrada → Adicionar</code>. Para WhatsApp, veja a seção <a href="#whatsapp">WhatsApp</a>.</li>
          <li><strong>Convide seu time</strong> em <code>Configurações → Agentes</code> e organize em times.</li>
          <li><strong>Siga o onboarding guiado</strong> — o botão circular (foguete) no canto inferior direito abre o tutorial passo a passo com destaque na tela.</li>
        </ol>
        <div class="callout tip"><span class="ic">💡</span><p><strong>Dica:</strong> o widget de onboarding aparece só para contas novas e some quando o essencial está configurado. Se algo for desfeito, ele reaparece.</p></div>
      </section>

      <section id="conceitos">
        <h2>Conceitos-chave</h2>
        <table>
          <thead><tr><th>Termo</th><th>O que é</th></tr></thead>
          <tbody>
            <tr><td>Conta</td><td>Workspace isolado (multi-tenant). Cada cliente tem a sua.</td></tr>
            <tr><td>Caixa de entrada</td><td>Um canal conectado (um número de WhatsApp, um e-mail, etc.).</td></tr>
            <tr><td>Conversa</td><td>Thread de mensagens com um contato em um canal.</td></tr>
            <tr><td>Agente</td><td>Usuário do time que atende conversas.</td></tr>
            <tr><td>Chatflow</td><td>Fluxo automatizado de mensagens, menus e ações.</td></tr>
            <tr><td>Funil</td><td>Pipeline Kanban com estágios para oportunidades.</td></tr>
            <tr><td>Agente de IA</td><td>Agente automático com base de conhecimento (RAG) que atende sozinho.</td></tr>
          </tbody>
        </table>
      </section>

      <section id="inbox">
        <h2>Caixa de entrada</h2>
        <p>O coração do atendimento. Toda mensagem recebida vira uma conversa atribuível, etiquetável e resolvível.</p>
        <h3>Status de conversa</h3>
        <ul>
          <li><strong>Aberta</strong> — aguardando ação do time.</li>
          <li><strong>Pendente</strong> — aguardando o cliente.</li>
          <li><strong>Resolvida</strong> — encerrada (reabre se o cliente responder).</li>
        </ul>
        <h3>Recursos</h3>
        <ul>
          <li><strong>Atribuição</strong> a agentes e times.</li>
          <li><strong>Etiquetas (labels)</strong> para categorizar e filtrar.</li>
          <li><strong>Respostas rápidas</strong> (canned responses) e notas privadas.</li>
          <li><strong>Mover para Kanban</strong> direto da conversa.</li>
        </ul>
      </section>

      <section id="whatsapp">
        <h2>WhatsApp</h2>
        <p>O UniverZAP conecta WhatsApp de duas formas:</p>
        <table>
          <thead><tr><th></th><th>WAHA (não-oficial)</th><th>Cloud API (oficial Meta)</th></tr></thead>
          <tbody>
            <tr><td>Conexão</td><td>QR Code no celular</td><td>App Meta + número verificado</td></tr>
            <tr><td>Menus interativos</td><td>Texto numerado</td><td>Botões/listas nativas</td></tr>
            <tr><td>Risco de ban</td><td>Maior</td><td>Menor (oficial)</td></tr>
            <tr><td>Indicado para</td><td>Início / volume baixo</td><td>Operação séria / escala</td></tr>
          </tbody>
        </table>
        <div class="callout warn"><span class="ic">⚠️</span><p>Em canais WAHA, menus saem como <strong>texto numerado</strong> — botões e listas interativas só existem na Cloud API oficial.</p></div>
        <h3>Coexistência</h3>
        <p>Desde 2025 o mesmo número pode rodar o app do WhatsApp Business <em>e</em> a Cloud API simultaneamente (coexistência Meta). Útil para migrar de WAHA para oficial sem perder o número.</p>
      </section>

      <section id="contatos">
        <h2>Contatos</h2>
        <p>Cada pessoa que fala com você vira um contato com histórico unificado entre canais. Suporta atributos personalizados, notas, e importação. Contatos alimentam campanhas e funis.</p>
      </section>

      <section id="chatflow">
        <h2>Chatflow</h2>
        <p>Construtor visual de fluxos automatizados. Arraste nós, conecte e publique. Dispara na primeira mensagem (com cooldown configurável) e tem <strong>modo teste</strong> que gateia o fluxo para um único número antes de ir ao ar.</p>
        <h3>Tipos de nó</h3>
        <ul>
          <li><strong>Enviar mensagem / áudio / mídia</strong></li>
          <li><strong>Menu</strong> — opções numeradas que ramificam o fluxo</li>
          <li><strong>Etiqueta</strong> — aplica/remove labels</li>
          <li><strong>Atribuir agente</strong></li>
          <li><strong>Adicionar ao Kanban</strong></li>
          <li><strong>Webhook</strong> — integra sistemas externos</li>
          <li><strong>Encerrar fluxo</strong></li>
        </ul>
        <div class="callout tip"><span class="ic">💡</span><p><strong>Sempre teste antes:</strong> ative o modo teste e aponte para o seu número. O fluxo dispara só para ele, mesmo em rascunho — zero risco de spammar clientes.</p></div>
      </section>

      <section id="athenas">
        <h2>Agente de IA</h2>
        <p>Agentes de IA que respondem com base no seu conhecimento.</p>
        <ul>
          <li><strong>Agentes</strong>: defina nome, prompt e comportamento.</li>
          <li><strong>RAG (base de conhecimento)</strong>: suba documentos e a IA responde com contexto real.</li>
          <li><strong>Copiloto</strong>: sugere respostas ao atendente dentro da conversa.</li>
          <li><strong>Créditos</strong>: uso de IA é medido em créditos; acompanhe o saldo no painel do Agente de IA.</li>
        </ul>
      </section>

      <section id="campanhas">
        <h2>Campanhas</h2>
        <p>Disparo de mensagens em massa para listas de contatos.</p>
        <ul>
          <li><strong>Cloud API oficial</strong> — templates aprovados pela Meta com mapeamento completo de variáveis (nome do contato, pedido, etc.).</li>
          <li><strong>Segmentação</strong> por etiquetas e atributos.</li>
          <li><strong>Agendamento</strong> e acompanhamento de entrega.</li>
        </ul>
        <div class="callout note"><span class="ic">📋</span><p>Campanhas via template exigem variáveis mapeadas corretamente — o nome do contato e demais tokens são resolvidos por destinatário no envio.</p></div>
      </section>

      <section id="kanban">
        <h2>Funis Kanban</h2>
        <p>Organize oportunidades em pipelines visuais. Cada funil tem estágios (colunas) e cards arrastáveis.</p>
        <ul>
          <li>Crie múltiplos funis (ex.: Vendas, Suporte, Pós-venda).</li>
          <li>Mova cards entre estágios por arrastar-e-soltar.</li>
          <li>Vincule conversas e contatos a um card.</li>
          <li>Cards têm prioridade, responsáveis, etiquetas, datas e <strong>anexos</strong>.</li>
        </ul>
      </section>

      <section id="tarefas">
        <h2>Tarefas</h2>
        <p>Gestão de trabalho do time, separada dos funis. Aba <strong>Tarefas</strong> na barra lateral.</p>
        <ul>
          <li><strong>Criar tarefa</strong> com título, descrição, responsáveis, urgência e prazo.</li>
          <li><strong>Anexos</strong> — fotos, imagens, arquivos (zip/tar), vídeos. Adicione ao criar ou dentro da tarefa aberta.</li>
          <li><strong>Recorrência</strong> — tarefas que se repetem automaticamente.</li>
          <li><strong>Converter para card Kanban</strong> quando virar oportunidade.</li>
          <li>Comentários, feed de atividade e relatórios de carga do time.</li>
        </ul>
        <div class="callout tip"><span class="ic">📎</span><p><strong>Anexos:</strong> abra a tarefa (ou o modal de criação) → seção <em>Anexos</em> → <em>Adicionar anexo</em>. Suporta múltiplos arquivos de uma vez.</p></div>
      </section>

      <section id="metas">
        <h2>Metas</h2>
        <p>Defina objetivos e acompanhe o progresso em tempo real.</p>
        <ul>
          <li><strong>Metas de venda</strong> — valor em R$, com registro de venda (número do pedido + data de pagamento).</li>
          <li><strong>Metas personalizadas (contadores)</strong> — qualquer unidade contável (ex.: "Depoimentos", "Reuniões"), medida por número em vez de R$.</li>
          <li>Cada card de meta mostra o realizado vs. o alvo.</li>
        </ul>
      </section>

      <section id="relatorios">
        <h2>Relatórios</h2>
        <p>Visão de desempenho: volume de conversas, tempo de resposta, resolução, produtividade por agente e por time, evolução de metas. Use para decisões e acompanhamento de SLA.</p>
      </section>

      <section id="guia-primeiro-bot">
        <h2>Guia: montar seu 1º bot</h2>
        <ol class="steps">
          <li>Conecte uma caixa de entrada de WhatsApp.</li>
          <li>Vá em <code>Chatflow → Novo fluxo</code>.</li>
          <li>Adicione um nó de <strong>saudação</strong> (Enviar mensagem).</li>
          <li>Adicione um nó de <strong>Menu</strong> com as opções (ex.: 1 Vendas, 2 Suporte).</li>
          <li>Para cada opção, conecte um nó de <strong>Atribuir agente</strong> ou <strong>Etiqueta</strong>.</li>
          <li>Ative o <strong>modo teste</strong>, aponte para o seu número e valide.</li>
          <li>Publique. Pronto — atendimento automático no ar.</li>
        </ol>
      </section>

      <section id="guia-funil">
        <h2>Guia: criar um funil de vendas</h2>
        <ol class="steps">
          <li>Vá em <code>Kanban → Novo funil</code> e nomeie (ex.: "Vendas 2026").</li>
          <li>Defina os estágios (ex.: Novo lead → Qualificado → Proposta → Fechado).</li>
          <li>Dentro de uma conversa, use <strong>Mover para Kanban</strong> para criar o card.</li>
          <li>Arraste os cards conforme a oportunidade avança.</li>
          <li>Acompanhe conversão por estágio nos <a href="#relatorios">Relatórios</a>.</li>
        </ol>
      </section>

      <section id="api">
        <h2>API &amp; Webhooks</h2>
        <p>O UniverZAP expõe uma API REST por conta. Endpoints são <em>account-scoped</em>:</p>
        <pre><code>GET /api/v1/accounts/:account_id/conversations
POST /api/v1/accounts/:account_id/conversations/:id/messages</code></pre>
        <p>Autentique com o token de acesso do agente (header <code>api_access_token</code>). Webhooks notificam eventos (mensagem recebida, conversa criada/resolvida) para a URL configurada. Referência viva da API em <a href="/api">/api</a>.</p>
        <div class="callout note"><span class="ic">🔑</span><p>Mantenha tokens em sigilo. Nunca exponha <code>api_access_token</code> em código cliente ou repositórios públicos.</p></div>
      </section>

      <section id="seguranca">
        <h2>Segurança &amp; LGPD</h2>
        <ul>
          <li>Isolamento multi-tenant por conta.</li>
          <li>Dados tratados conforme a LGPD; canal do DPO disponível.</li>
          <li>Exclusão de conta e dados pelo titular (Art. 18 VI da LGPD).</li>
        </ul>
        <p>Consulte os <a href="/termos">Termos de Uso</a> e a <a href="/privacidade">Política de Privacidade</a>.</p>
      </section>

      <section id="versoes">
        <h2>Versões</h2>
        <p>Documentação versionada. Versão atual: <strong>v<%= @version %></strong>.</p>
        <table>
          <thead><tr><th>Versão</th><th>Data</th><th>Novidades</th></tr></thead>
          <tbody>
            <% @changelog.each do |entry| %>
              <tr>
                <td><code><%= entry[:version] %></code></td>
                <td><%= Date.parse(entry[:date]).strftime('%d/%m/%Y') %></td>
                <td><%= entry[:notes] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>

      <section id="faq">
        <h2>FAQ</h2>
        <h3>Meu número de WhatsApp pode ser banido?</h3>
        <p>O risco existe em canais não-oficiais (WAHA). A Cloud API oficial reduz drasticamente esse risco. Respeite as políticas do WhatsApp Business.</p>
        <h3>Posso migrar de WAHA para a API oficial sem trocar de número?</h3>
        <p>Sim. A coexistência da Meta permite rodar ambos no mesmo número durante a transição.</p>
        <h3>O onboarding sumiu, é normal?</h3>
        <p>Sim. Ele aparece só para contas novas e some quando o essencial está configurado. Reaparece se algo for desfeito.</p>
        <h3>Como adiciono anexos a uma tarefa?</h3>
        <p>Abra a tarefa (ou o modal de criação) → seção <em>Anexos</em> → <em>Adicionar anexo</em>.</p>
      </section>

      <section id="suporte">
        <h2>Suporte</h2>
        <p>Precisa de ajuda? Fale com a gente:</p>
        <ul>
          <li>Suporte: <a href="mailto:suporte@univerbeauty.com.br">suporte@univerbeauty.com.br</a></li>
          <li>Privacidade / DPO: <a href="mailto:privacidade@univerbeauty.com.br">privacidade@univerbeauty.com.br</a></li>
        </ul>
      </section>

      <footer>
        <p>UniverZAP · Documentação v<%= @version %> · operado por UniverBeauty / UniverZap.</p>
        <p><a href="/app">Plataforma</a> · <a href="/termos">Termos</a> · <a href="/privacidade">Privacidade</a> · <a href="/api">API</a></p>
      </footer>
    </main>
  </div>

  <script>
    (function () {
      var nav = document.getElementById('nav');
      var links = Array.prototype.slice.call(nav.querySelectorAll('a'));
      var sections = links.map(function (a) {
        return document.getElementById(a.getAttribute('href').slice(1));
      });

      // Scrollspy — highlight the section currently in view.
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var id = entry.target.getAttribute('id');
          links.forEach(function (a) {
            a.classList.toggle('active', a.getAttribute('href') === '#' + id);
          });
        });
      }, { rootMargin: '-10% 0px -75% 0px', threshold: 0 });
      sections.forEach(function (s) { if (s) observer.observe(s); });

      // Mobile drawer.
      var sidebar = document.getElementById('sidebar');
      var menuBtn = document.getElementById('menuBtn');
      menuBtn.addEventListener('click', function () { sidebar.classList.toggle('open'); });
      links.forEach(function (a) {
        a.addEventListener('click', function () { sidebar.classList.remove('open'); });
      });

      // Sidebar search filter.
      var search = document.getElementById('docSearch');
      var empty = document.getElementById('navEmpty');
      search.addEventListener('input', function () {
        var q = search.value.trim().toLowerCase();
        var anyVisible = false;
        links.forEach(function (a) {
          var match = !q || a.textContent.toLowerCase().indexOf(q) !== -1;
          a.classList.toggle('hidden', !match);
          if (match) anyVisible = true;
        });
        nav.querySelectorAll('.nav-group').forEach(function (g) {
          var visible = g.querySelectorAll('a:not(.hidden)').length > 0;
          g.style.display = visible ? '' : 'none';
        });
        empty.style.display = anyVisible ? 'none' : 'block';
      });
    })();
  </script>
</body>
</html>
