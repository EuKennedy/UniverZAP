<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Status · UniverZAP</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif;
      background: #0a0f0e;
      color: #f1f5f4;
      min-height: 100vh;
      padding: 48px 16px;
    }
    .shell { max-width: 720px; margin: 0 auto; }
    h1 { font-size: 24px; margin: 0 0 8px; letter-spacing: -0.02em; font-weight: 600; }
    .overall {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 10px 16px; border-radius: 999px;
      font-weight: 600; font-size: 14px;
      margin-bottom: 32px;
    }
    .overall.operational { background: rgba(19, 203, 141, 0.16); color: #60E8B8; border: 1px solid rgba(19, 203, 141, 0.4); }
    .overall.degraded { background: rgba(244, 63, 94, 0.14); color: #fda4af; border: 1px solid rgba(244, 63, 94, 0.4); }
    .dot { width: 10px; height: 10px; border-radius: 50%; background: currentColor; }
    .dot.pulse { animation: pulse 1.6s ease-in-out infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.6; transform: scale(1.4); } }

    .service {
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 20px; border-radius: 14px;
      background: rgba(20, 27, 26, 0.85);
      border: 1px solid rgba(148, 163, 184, 0.12);
      margin-bottom: 10px;
    }
    .service .label { font-weight: 500; text-transform: capitalize; }
    .service .meta { font-size: 12px; color: #94a3b8; }
    .badge {
      padding: 4px 10px; border-radius: 999px;
      font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.06em;
    }
    .badge.ok { background: rgba(19, 203, 141, 0.2); color: #60E8B8; }
    .badge.down, .badge.idle { background: rgba(244, 63, 94, 0.18); color: #fda4af; }
    .badge.unknown { background: rgba(245, 158, 11, 0.18); color: #fcd34d; }

    .footer {
      margin-top: 32px; padding-top: 16px;
      border-top: 1px solid rgba(148, 163, 184, 0.1);
      font-size: 12px; color: #64748b;
      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
    }
    .footer a { color: #60E8B8; text-decoration: none; }
  </style>
</head>
<body>
  <div class="shell">
    <h1>Status do sistema</h1>
    <div class="overall <%= @summary[:overall] %>">
      <span class="dot pulse"></span>
      <%= @summary[:overall] == 'operational' ? 'Todos os serviços operacionais' : 'Sistema degradado' %>
    </div>

    <% @summary[:services].each do |key, svc| %>
      <div class="service">
        <div>
          <div class="label"><%= svc[:name] %></div>
          <div class="meta">
            <% if svc[:latency_ms] %>
              latência <%= svc[:latency_ms] %>ms
            <% else %>
              indisponível
            <% end %>
          </div>
        </div>
        <span class="badge <%= svc[:status] %>"><%= svc[:status] %></span>
      </div>
    <% end %>

    <div class="footer">
      <span>commit <code><%= @summary[:commit] %></code></span>
      <span>verificado em <%= @summary[:checked_at] %></span>
    </div>
  </div>
  <script>
    // Auto-refresh a cada 30s sem reload (mantém scroll + posiciona aviso).
    setTimeout(function () { window.location.reload(); }, 30000);
  </script>
</body>
</html>
