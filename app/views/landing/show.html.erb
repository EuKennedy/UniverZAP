  <script>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reveal on scroll
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

      // Nav scrolled state
      var nav = document.getElementById('nav');
      var onScroll = function () { nav.classList.toggle('scrolled', window.scrollY > 30); };
      onScroll(); window.addEventListener('scroll', onScroll, { passive: true });

      // Parallax orbs
      if (!reduce) {
        var orbs = Array.prototype.slice.call(document.querySelectorAll('.orb'));
        var ticking = false;
        window.addEventListener('scroll', function () {
          if (ticking) return; ticking = true;
          requestAnimationFrame(function () {
            var y = window.scrollY;
            orbs.forEach(function (o) {
              var s = parseFloat(o.getAttribute('data-speed') || '0.1');
              o.style.transform = 'translateY(' + (y * s) + 'px)';
            });
            ticking = false;
          });
        }, { passive: true });
      }

      // Faux animated QR (decorative)
      var qr = document.getElementById('qrCanvas');
      if (qr) {
        var N = 21, cell = 100 / N, ns = 'http://www.w3.org/2000/svg', html = '';
        function finder(x, y) {
          html += '<rect x="' + (x*cell) + '" y="' + (y*cell) + '" width="' + (cell*7) + '" height="' + (cell*7) + '" rx="3" fill="#0a0f0e"/>';
          html += '<rect x="' + ((x+1)*cell) + '" y="' + ((y+1)*cell) + '" width="' + (cell*5) + '" height="' + (cell*5) + '" rx="2" fill="#fff"/>';
          html += '<rect x="' + ((x+2)*cell) + '" y="' + ((y+2)*cell) + '" width="' + (cell*3) + '" height="' + (cell*3) + '" rx="1.5" fill="#13CB8D"/>';
        }
        // pseudo-random but stable modules
        var seed = 7;
        function rnd() { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; }
        for (var r = 0; r < N; r++) {
          for (var c = 0; c < N; c++) {
            var inFinder = (r < 8 && c < 8) || (r < 8 && c > N-9) || (r > N-9 && c < 8);
            if (inFinder) continue;
            if (rnd() > 0.55) {
              html += '<rect x="' + (c*cell) + '" y="' + (r*cell) + '" width="' + (cell*0.92) + '" height="' + (cell*0.92) + '" rx="1" fill="#0a0f0e"/>';
            }
          }
        }
        finder(0, 0); finder(N-7, 0); finder(0, N-7);
        qr.innerHTML = html;
      }

      // Connect tabs
      var tabs = document.getElementById('connTabs');
      if (tabs) {
        tabs.addEventListener('click', function (ev) {
          var b = ev.target.closest('button'); if (!b) return;
          tabs.querySelectorAll('button').forEach(function (x) { x.classList.remove('on'); });
          b.classList.add('on');
          var t = b.getAttribute('data-tab');
          document.getElementById('tab-oficial').style.display = t === 'oficial' ? '' : 'none';
          document.getElementById('tab-qr').style.display = t === 'qr' ? '' : 'none';
        });
      }

      // Drag-to-scroll + gentle autoplay for carousels
      document.querySelectorAll('[data-carousel]').forEach(function (car) {
        var down = false, startX, startScroll;
        car.addEventListener('pointerdown', function (e) { down = true; car.classList.add('drag'); startX = e.pageX; startScroll = car.scrollLeft; });
        window.addEventListener('pointerup', function () { down = false; car.classList.remove('drag'); });
        car.addEventListener('pointermove', function (e) { if (!down) return; e.preventDefault(); car.scrollLeft = startScroll - (e.pageX - startX); });
        if (!reduce) {
          var paused = false;
          car.addEventListener('pointerenter', function () { paused = true; });
          car.addEventListener('pointerleave', function () { paused = false; });
          setInterval(function () {
            if (paused || down) return;
            if (car.scrollLeft + car.clientWidth >= car.scrollWidth - 4) car.scrollTo({ left: 0, behavior: 'smooth' });
            else car.scrollBy({ left: 1, behavior: 'auto' });
          }, 28);
        }
      });

      // Mobile menu → smooth scroll to anchors (links already anchor); just toggle nothing heavy
      var mb = document.getElementById('menuBtn');
      if (mb) mb.addEventListener('click', function () { document.getElementById('planos').scrollIntoView({ behavior: 'smooth' }); });

      // Scroll progress bar
      var prog = document.getElementById('progress');
      var setProg = function () {
        var h = document.documentElement.scrollHeight - window.innerHeight;
        prog.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
      };
      setProg(); window.addEventListener('scroll', setProg, { passive: true });

      // Cursor glow (liquid spotlight) — pointer devices only
      var glow = document.getElementById('cursorGlow');
      if (glow && !reduce && window.matchMedia('(pointer:fine)').matches) {
        window.addEventListener('pointermove', function (e) {
          glow.style.opacity = '1';
          glow.style.left = e.clientX + 'px';
          glow.style.top = e.clientY + 'px';
        }, { passive: true });
      }

      // 3D tilt on glass cards
      if (!reduce && window.matchMedia('(pointer:fine)').matches) {
        document.querySelectorAll('.tilt').forEach(function (card) {
          card.addEventListener('pointermove', function (e) {
            var r = card.getBoundingClientRect();
            var px = (e.clientX - r.left) / r.width - 0.5;
            var py = (e.clientY - r.top) / r.height - 0.5;
            card.style.transform = 'perspective(900px) rotateY(' + (px * 9) + 'deg) rotateX(' + (-py * 9) + 'deg) translateZ(0)';
          });
          card.addEventListener('pointerleave', function () { card.style.transform = ''; });
        });
      }

      // Nav scrollspy
      var navLinks = Array.prototype.slice.call(document.querySelectorAll('nav.bar .nav-links a'));
      var spyTargets = navLinks.map(function (a) { return document.querySelector(a.getAttribute('href')); });
      var spy = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          navLinks.forEach(function (a) { a.classList.toggle('active', a.getAttribute('href') === '#' + en.target.id); });
        });
      }, { rootMargin: '-45% 0px -50% 0px' });
      spyTargets.forEach(function (t) { if (t) spy.observe(t); });

      // Pricing billing toggle
      var bill = document.getElementById('bill');
      if (bill) {
        var sw = document.getElementById('billSw');
        var amts = Array.prototype.slice.call(document.querySelectorAll('.amt'));
        var toggle = function () {
          var annual = bill.classList.toggle('annual');
          document.getElementById('optM').classList.toggle('on', !annual);
          document.getElementById('optA').classList.toggle('on', annual);
          amts.forEach(function (s) { s.textContent = annual ? s.getAttribute('data-a') : s.getAttribute('data-m'); });
        };
        sw.addEventListener('click', toggle);
        document.getElementById('optA').addEventListener('click', function () { if (!bill.classList.contains('annual')) toggle(); });
        document.getElementById('optM').addEventListener('click', function () { if (bill.classList.contains('annual')) toggle(); });
      }
    })();
  </script>
</body>
