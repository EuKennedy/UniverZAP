<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="UniverZAP — a plataforma que transforma o WhatsApp do seu negócio em uma máquina de atendimento e vendas. API oficial Meta, IA Athenas, automação Chatflow e funis de venda." />
  <title>UniverZAP · Seu WhatsApp, no controle total</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --brand: #13CB8D;
      --brand-2: #22C55E;
      --brand-soft: #5FE9B6;
      --brand-deep: #0B8F63;
      --ink: #0a0f0e;
      --ink-2: #0e1514;
      --paper: #f4f8f6;
      --paper-2: #ffffff;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: "Montserrat", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      background: var(--ink);
      color: #f1f5f4;
      line-height: 1.6;
      letter-spacing: -0.01em;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    ::selection { background: rgba(19,203,141,0.32); color: #fff; }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }

    /* ---- Section theming (alternating) ---- */
    .sect { position: relative; padding: 120px 24px; overflow: hidden; }
    .sect .inner { max-width: 1140px; margin: 0 auto; position: relative; z-index: 2; }
    .sect-dark { background: var(--ink); color: #eef2f1; }
    .sect-dark-2 { background: linear-gradient(180deg, #0b1211, var(--ink)); color: #eef2f1; }
    .sect-light { background: var(--paper); color: #0b1a15; }
    .sect-light .muted { color: #4b5d57; }
    .sect-dark .muted, .sect-dark-2 .muted { color: #9fb0ab; }

    /* ---- Typography ---- */
    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 12.5px; font-weight: 700; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--brand);
      margin-bottom: 20px;
    }
    .eyebrow::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 12px var(--brand); }
    h1, h2, h3 { font-weight: 800; letter-spacing: -0.035em; line-height: 1.05; margin: 0; }
    .display { font-size: clamp(40px, 7vw, 86px); font-weight: 900; }
    h2.title { font-size: clamp(30px, 4.5vw, 54px); margin-bottom: 18px; }
    .lede { font-size: clamp(16px, 1.6vw, 20px); font-weight: 400; max-width: 56ch; }
    .grad-text {
      background: linear-gradient(100deg, var(--brand-soft), var(--brand) 45%, #38e0ff 90%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }

    /* ---- Buttons ---- */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 9px;
      font-family: inherit; font-weight: 700; font-size: 15px;
      padding: 15px 26px; border-radius: 999px; cursor: pointer;
      border: 1px solid transparent; transition: transform .25s cubic-bezier(.16,1,.3,1), box-shadow .25s, background .25s, color .25s;
      white-space: nowrap;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-primary {
      color: #04130d;
      background: linear-gradient(135deg, var(--brand-soft), var(--brand) 55%, var(--brand-deep));
      box-shadow: 0 12px 38px -10px rgba(19,203,141,.7), inset 0 1px 0 rgba(255,255,255,.4);
    }
    .btn-primary:hover { box-shadow: 0 18px 50px -10px rgba(19,203,141,.85); }
    .btn-ghost {
      color: #f1f5f4; background: rgba(255,255,255,.06);
      border-color: rgba(255,255,255,.16); backdrop-filter: blur(12px);
    }
    .sect-light .btn-ghost { color: #0b1a15; background: rgba(11,26,21,.04); border-color: rgba(11,26,21,.12); }
    .btn-ghost:hover { border-color: var(--brand); }

    /* ---- Liquid glass ---- */
    .glass {
      position: relative;
      background: rgba(255,255,255,.055);
      backdrop-filter: blur(24px) saturate(165%);
      -webkit-backdrop-filter: blur(24px) saturate(165%);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 22px;
      box-shadow: 0 24px 70px -28px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.18);
    }
    .sect-light .glass {
      background: rgba(255,255,255,.6);
      border-color: rgba(11,26,21,.08);
      box-shadow: 0 24px 60px -30px rgba(11,90,60,.35), inset 0 1px 0 rgba(255,255,255,.8);
    }
    /* Iridescent rainbow border on hover-able glass */
    .glass.iris::before {
      content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px;
      background: conic-gradient(from 0deg, #13CB8D, #38e0ff, #9b8cff, #ff7ad9, #ffd166, #13CB8D);
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude;
      opacity: .0; transition: opacity .4s; pointer-events: none;
    }
    .glass.iris:hover::before { opacity: .9; animation: spin 6s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ---- Aurora / liquid orbs ---- */
    .orbs { position: absolute; inset: 0; z-index: 0; pointer-events: none; filter: blur(60px); }
    .orb { position: absolute; border-radius: 50%; opacity: .55; will-change: transform; }
    .orb.a { width: 520px; height: 520px; background: radial-gradient(circle, rgba(19,203,141,.9), transparent 65%); top: -120px; left: -80px; }
    .orb.b { width: 460px; height: 460px; background: radial-gradient(circle, rgba(56,224,255,.7), transparent 65%); top: 30%; right: -120px; }
    .orb.c { width: 400px; height: 400px; background: radial-gradient(circle, rgba(155,140,255,.6), transparent 65%); bottom: -120px; left: 30%; }
    @keyframes float-y { 0%,100% { transform: translateY(0) } 50% { transform: translateY(-40px) } }

    /* ---- Nav ---- */
    nav.bar {
      position: fixed; top: 14px; left: 50%; transform: translateX(-50%);
      width: calc(100% - 28px); max-width: 1180px; z-index: 100;
      display: flex; align-items: center; gap: 16px;
      padding: 11px 14px 11px 20px; border-radius: 999px;
      background: rgba(10,15,14,.55); backdrop-filter: blur(18px) saturate(160%);
      border: 1px solid rgba(255,255,255,.1);
      transition: background .3s, box-shadow .3s, top .3s;
    }
    nav.bar.scrolled { background: rgba(10,15,14,.82); box-shadow: 0 14px 40px -16px rgba(0,0,0,.6); top: 8px; }
    nav.bar .logo { height: 26px; }
    nav.bar .nav-links { display: flex; gap: 6px; margin-left: 10px; }
    nav.bar .nav-links a {
      font-size: 14px; font-weight: 500; color: #cfe3db; padding: 8px 13px; border-radius: 999px;
      transition: color .2s, background .2s;
    }
    nav.bar .nav-links a:hover { color: #fff; background: rgba(255,255,255,.07); }
    nav.bar .spacer { flex: 1; }
    nav .menu-btn { display: none; background: none; border: none; color: #fff; cursor: pointer; padding: 6px; }

    /* ---- Hero ---- */
    .hero { min-height: 100vh; display: flex; align-items: center; padding-top: 130px; }
    .hero .badge {
      display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600;
      padding: 7px 14px; border-radius: 999px; margin-bottom: 26px;
      background: rgba(19,203,141,.12); border: 1px solid rgba(19,203,141,.3); color: var(--brand-soft);
    }
    .hero .cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 34px; }
    .hero .trust { display: flex; gap: 26px; flex-wrap: wrap; margin-top: 46px; }
    .hero .trust .t { }
    .hero .trust .n { font-size: 30px; font-weight: 900; letter-spacing: -.04em; }
    .hero .trust .l { font-size: 12.5px; color: #9fb0ab; font-weight: 500; }
    .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 50px; align-items: center; }

    /* Floating mock chat in hero */
    .mock { padding: 18px; }
    .mock .row { display: flex; gap: 10px; margin-bottom: 12px; align-items: flex-end; }
    .mock .row.me { flex-direction: row-reverse; }
    .mock .av { width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(135deg, var(--brand), var(--brand-deep)); flex-shrink: 0; }
    .mock .bub { max-width: 76%; padding: 10px 14px; border-radius: 16px; font-size: 13.5px; line-height: 1.45; }
    .mock .bub.them { background: rgba(255,255,255,.08); border-bottom-left-radius: 5px; }
    .mock .bub.me { background: linear-gradient(135deg, var(--brand), var(--brand-deep)); color: #04130d; font-weight: 600; border-bottom-right-radius: 5px; }
    .mock .tag { font-size: 11px; color: var(--brand-soft); font-weight: 700; letter-spacing: .04em; }

    /* ---- Reveal motion ---- */
    .reveal { opacity: 0; transform: translateY(28px); transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1); }
    .reveal.in { opacity: 1; transform: none; }
    .reveal.d1 { transition-delay: .08s } .reveal.d2 { transition-delay: .16s } .reveal.d3 { transition-delay: .24s } .reveal.d4 { transition-delay: .32s }

    /* ---- Generic grids ---- */
    .cols-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: center; }
    .cards-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .bento { display: grid; grid-template-columns: repeat(6, 1fr); gap: 18px; }
    .bento .cell { padding: 26px; border-radius: 22px; }
    .bento .span3 { grid-column: span 3; } .bento .span2 { grid-column: span 2; } .bento .span6 { grid-column: span 6; }
    .feat-ic {
      width: 46px; height: 46px; border-radius: 13px; display: grid; place-content: center;
      background: linear-gradient(135deg, rgba(19,203,141,.22), rgba(56,224,255,.16));
      border: 1px solid rgba(19,203,141,.3); margin-bottom: 16px; color: var(--brand-soft);
    }
    .sect-light .feat-ic { color: var(--brand-deep); }
    h3.card-h { font-size: 19px; margin-bottom: 8px; font-weight: 700; letter-spacing: -.02em; }
    .card-p { font-size: 14.5px; }

    svg.ic { width: 24px; height: 24px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    svg.ic-sm { width: 18px; height: 18px; }

    /* ---- Pain vs Gain ---- */
    .vs { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
    .vs .panel { padding: 30px; border-radius: 22px; }
    .vs .bad { background: rgba(244,63,94,.07); border: 1px solid rgba(244,63,94,.22); }
    .vs .good { background: rgba(19,203,141,.08); border: 1px solid rgba(19,203,141,.3); }
    .vs ul { list-style: none; padding: 0; margin: 16px 0 0; }
    .vs li { display: flex; gap: 11px; align-items: flex-start; margin-bottom: 13px; font-size: 14.5px; }
    .vs .bad li svg { color: #fb7185; flex-shrink: 0; } .vs .good li svg { color: var(--brand); flex-shrink: 0; }
    .vs h3 { font-size: 20px; margin-bottom: 4px; }

    /* ---- QR ---- */
    .qr-wrap { display: grid; place-items: center; }
    .qr {
      position: relative; width: 230px; height: 230px; padding: 16px; border-radius: 26px;
      background: #fff; box-shadow: 0 30px 70px -24px rgba(19,203,141,.5);
    }
    .qr svg { width: 100%; height: 100%; }
    .qr .scan {
      position: absolute; left: 16px; right: 16px; height: 3px; top: 16px;
      background: linear-gradient(90deg, transparent, var(--brand), transparent);
      box-shadow: 0 0 16px 3px rgba(19,203,141,.8); border-radius: 3px;
      animation: scan 2.4s ease-in-out infinite;
    }
    @keyframes scan { 0%,100% { transform: translateY(0) } 50% { transform: translateY(196px) } }
    .qr .corner { position: absolute; width: 26px; height: 26px; border: 3px solid var(--brand); }
    .qr .corner.tl { top: 6px; left: 6px; border-right: 0; border-bottom: 0; border-radius: 8px 0 0 0; }
    .qr .corner.tr { top: 6px; right: 6px; border-left: 0; border-bottom: 0; border-radius: 0 8px 0 0; }
    .qr .corner.bl { bottom: 6px; left: 6px; border-right: 0; border-top: 0; border-radius: 0 0 0 8px; }
    .qr .corner.br { bottom: 6px; right: 6px; border-left: 0; border-top: 0; border-radius: 0 0 8px 0; }
    .conn-tabs { display: inline-flex; padding: 5px; border-radius: 999px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); margin-bottom: 24px; }
    .sect-light .conn-tabs { background: rgba(11,26,21,.05); border-color: rgba(11,26,21,.1); }
    .conn-tabs button {
      font-family: inherit; font-weight: 600; font-size: 13.5px; cursor: pointer; border: none;
      padding: 9px 18px; border-radius: 999px; background: transparent; color: inherit; transition: .25s;
    }
    .conn-tabs button.on { background: linear-gradient(135deg, var(--brand), var(--brand-deep)); color: #04130d; }

    /* ---- Carousels ---- */
    .carousel { display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 8px 2px 22px; -ms-overflow-style: none; scrollbar-width: none; cursor: grab; }
    .carousel::-webkit-scrollbar { display: none; }
    .carousel.drag { cursor: grabbing; }
    .review { scroll-snap-align: start; flex: 0 0 360px; max-width: 86vw; padding: 26px; border-radius: 22px; }
    .stars { display: flex; gap: 3px; color: #ffd166; margin-bottom: 14px; }
    .stars svg { width: 17px; height: 17px; fill: currentColor; stroke: none; }
    .review .who { display: flex; align-items: center; gap: 12px; margin-top: 18px; }
    .review .who .av { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, var(--brand), #38e0ff); flex-shrink: 0; }
    .review .who .nm { font-weight: 700; font-size: 14.5px; } .review .who .rl { font-size: 12.5px; color: #9fb0ab; }
    .sect-light .review .who .rl { color: #6b7d77; }
    .vid { scroll-snap-align: start; flex: 0 0 220px; aspect-ratio: 9/16; border-radius: 20px; position: relative; overflow: hidden;
      background: linear-gradient(160deg, #10201b, #0b1513); border: 1px solid rgba(255,255,255,.1); display: grid; place-content: center; }
    .sect-light .vid { background: linear-gradient(160deg, #e7f1ec, #d8e9e1); border-color: rgba(11,26,21,.08); }
    .vid .play { width: 56px; height: 56px; border-radius: 50%; background: rgba(19,203,141,.92); display: grid; place-content: center; color: #04130d; box-shadow: 0 10px 30px -8px rgba(19,203,141,.7); }
    .vid .lbl { position: absolute; bottom: 12px; left: 12px; right: 12px; font-size: 12px; font-weight: 600; color: #cfe3db; }
    .sect-light .vid .lbl { color: #3a4a44; }

    /* ---- Integrations ---- */
    .logos { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
    .logos .pill {
      display: inline-flex; align-items: center; gap: 9px; padding: 12px 18px; border-radius: 14px;
      font-weight: 600; font-size: 14px;
      background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
    }
    .sect-light .logos .pill { background: rgba(11,26,21,.03); border-color: rgba(11,26,21,.09); }
    .logos .pill .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--brand); }

    /* ---- Pricing ---- */
    .plans { display: grid; grid-template-columns: repeat(3,1fr); gap: 22px; align-items: stretch; }
    .plan { padding: 32px 28px; border-radius: 26px; display: flex; flex-direction: column; }
    .plan.hot { background: linear-gradient(180deg, rgba(19,203,141,.16), rgba(19,203,141,.04)); border: 1.5px solid var(--brand); transform: translateY(-10px); box-shadow: 0 30px 80px -30px rgba(19,203,141,.55); }
    .plan .pn { font-size: 15px; font-weight: 700; letter-spacing: .02em; text-transform: uppercase; color: var(--brand); }
    .plan .pp { font-size: 44px; font-weight: 900; letter-spacing: -.04em; margin: 14px 0 2px; }
    .plan .pp small { font-size: 15px; font-weight: 600; color: #9fb0ab; }
    .plan ul { list-style: none; padding: 0; margin: 20px 0 26px; flex: 1; }
    .plan li { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; margin-bottom: 11px; }
    .plan li svg { color: var(--brand); flex-shrink: 0; }
    .plan .tagpop { align-self: flex-start; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 5px 11px; border-radius: 999px; background: var(--brand); color: #04130d; margin-bottom: 14px; }

    /* ---- Footer ---- */
    footer.ft { background: #060b0a; color: #9fb0ab; padding: 70px 24px 40px; border-top: 1px solid rgba(255,255,255,.07); }
    footer.ft .inner { max-width: 1140px; margin: 0 auto; }
    footer.ft .top { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 30px; padding-bottom: 40px; border-bottom: 1px solid rgba(255,255,255,.07); }
    footer.ft h4 { color: #fff; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 14px; }
    footer.ft a { display: block; font-size: 14px; color: #9fb0ab; margin-bottom: 9px; transition: color .2s; }
    footer.ft a:hover { color: var(--brand-soft); }
    footer.ft .logo { height: 28px; margin-bottom: 16px; }
    footer.ft .bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-top: 26px; font-size: 12.5px; }

    .center { text-align: center; }
    .center .lede { margin-left: auto; margin-right: auto; }
    .mb-sm { margin-bottom: 14px; } .mt-lg { margin-top: 40px; }

    /* ---- Scroll progress ---- */
    .progress { position: fixed; top: 0; left: 0; height: 3px; width: 0; z-index: 200;
      background: linear-gradient(90deg, var(--brand-soft), var(--brand), #38e0ff); box-shadow: 0 0 12px rgba(19,203,141,.7); transition: width .08s linear; }

    /* ---- Cursor glow (liquid spotlight) ---- */
    .cursor-glow { position: fixed; top: 0; left: 0; width: 460px; height: 460px; border-radius: 50%; pointer-events: none; z-index: 1;
      transform: translate(-50%, -50%); background: radial-gradient(circle, rgba(19,203,141,.16), transparent 60%);
      mix-blend-mode: screen; opacity: 0; transition: opacity .4s; will-change: left, top; }
    .sect-light ~ .cursor-glow { } /* glow lives on body, fine over all */

    /* ---- 3D tilt ---- */
    .tilt { transform-style: preserve-3d; transition: transform .3s cubic-bezier(.16,1,.3,1); will-change: transform; }

    /* ---- Nav scrollspy active ---- */
    nav.bar .nav-links a.active { color: #fff; background: rgba(19,203,141,.18); }

    /* ---- Mesh grid backdrop (hero) ---- */
    .mesh { position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: .5;
      background-image: linear-gradient(rgba(19,203,141,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(19,203,141,.06) 1px, transparent 1px);
      background-size: 54px 54px; mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, #000 35%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, #000 35%, transparent 75%); }

    /* ---- Live pulse ---- */
    .live { display: inline-flex; align-items: center; gap: 7px; }
    .live .dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--brand); }
    .live .dot::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--brand); animation: ping 1.8s cubic-bezier(0,0,.2,1) infinite; }
    @keyframes ping { 0% { transform: scale(.6); opacity: .9 } 80%,100% { transform: scale(2.2); opacity: 0 } }

    /* ---- Social-proof marquee ---- */
    .marquee { margin-top: 56px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); overflow: hidden; }
    .marquee .track { display: flex; gap: 44px; width: max-content; animation: slide 26s linear infinite; }
    .marquee:hover .track { animation-play-state: paused; }
    .marquee .item { font-weight: 800; font-size: 17px; letter-spacing: -.01em; color: #cfe3db; opacity: .72; display: inline-flex; align-items: center; gap: 9px; white-space: nowrap; }
    .marquee .item svg { width: 18px; height: 18px; color: var(--brand); }
    @keyframes slide { to { transform: translateX(-50%); } }

    /* ---- Pricing billing toggle ---- */
    .bill { display: inline-flex; align-items: center; gap: 12px; margin-top: 22px; font-weight: 600; font-size: 14px; }
    .bill .sw { width: 52px; height: 28px; border-radius: 999px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.2); position: relative; cursor: pointer; transition: background .25s; }
    .bill .sw::after { content: ''; position: absolute; top: 2px; left: 2px; width: 22px; height: 22px; border-radius: 50%; background: #fff; transition: transform .28s cubic-bezier(.16,1,.3,1); }
    .bill.annual .sw { background: var(--brand); }
    .bill.annual .sw::after { transform: translateX(24px); }
    .bill .save { font-size: 12px; font-weight: 800; color: var(--brand-soft); background: rgba(19,203,141,.14); padding: 4px 10px; border-radius: 999px; }
    .bill .opt { color: #9fb0ab; } .bill .opt.on { color: #fff; }

    /* ---- Responsive ---- */
    @media (max-width: 920px) {
      .hero-grid, .cols-2, .vs { grid-template-columns: 1fr; }
      .cards-3, .plans { grid-template-columns: 1fr; }
      .bento { grid-template-columns: 1fr; }
      .bento .span3, .bento .span2, .bento .span6 { grid-column: auto; }
      .plan.hot { transform: none; }
      nav.bar .nav-links { display: none; }
      nav .menu-btn { display: inline-flex; }
      .sect { padding: 80px 20px; }
      footer.ft .top { grid-template-columns: 1fr 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .reveal { transition: none; opacity: 1; transform: none; }
      .orb, .qr .scan, .glass.iris:hover::before { animation: none !important; }
      .btn:hover { transform: none; }
    }
  </style>
</head>
<body>
  <div class="progress" id="progress"></div>
  <div class="cursor-glow" id="cursorGlow"></div>

