.conn .tg i{width:14px;height:14px}
.conn h3{font-size:1.55rem;margin-bottom:9px;letter-spacing:-.025em}.conn p{color:var(--slate);font-size:14.5px}
.qrwrap{display:flex;align-items:center;gap:16px;margin:20px 0 4px}
