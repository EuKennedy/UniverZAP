<button class="iconbtn totop" id="totop" aria-label="Voltar ao topo"><i data-lucide="arrow-up"></i></button>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
<script>
(function(){
  var reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
  var root=document.documentElement;
  if(localStorage.getItem('zg-theme')==='light')root.setAttribute('data-theme','light');
  var tg=document.getElementById('themeTg');
  if(tg)tg.addEventListener('click',function(){
    var light=root.getAttribute('data-theme')==='light';
    if(light){root.removeAttribute('data-theme');localStorage.setItem('zg-theme','dark');}
    else{root.setAttribute('data-theme','light');localStorage.setItem('zg-theme','light');}
  });

  function icons(){try{window.lucide&&lucide.createIcons()}catch(e){}}
  icons();setTimeout(icons,400);

  try{if(window.qrcode){var qr=qrcode(0,'M');qr.addData('https://grupo.univerzap.cloud');qr.make();var box=document.getElementById('qrbox');if(box)box.innerHTML=qr.createSvgTag({cellSize:4,margin:1,scalable:true});}}catch(e){}

  var hd=document.getElementById('hd'),prog=document.getElementById('prog'),last=0;
  var mcta=document.getElementById('mcta'),totop=document.getElementById('totop');
  function onScroll(){
    var y=window.scrollY;
    hd.classList.toggle('stuck',y>28);
    if(y>last&&y>420)hd.classList.add('hide');else hd.classList.remove('hide');
    last=y;
    var max=document.documentElement.scrollHeight-innerHeight;
    if(prog)prog.style.setProperty('--p',max>0?(y/max).toFixed(4):0);
    // A barra fixa entra depois do herói, quando o botão do topo já saiu de
    // cena, e sai de novo no bloco final, que já tem o próprio botão grande.
    var fim=document.getElementById('final');
    var perto=fim&&fim.getBoundingClientRect().top<innerHeight*.9;
    if(mcta)mcta.classList.toggle('on',y>620&&!perto);
    if(totop)totop.classList.toggle('on',y>900);
  }
  addEventListener('scroll',onScroll,{passive:true});onScroll();
  if(totop)totop.addEventListener('click',function(){scrollTo({top:0,behavior:reduce?'auto':'smooth'})});

  var burger=document.getElementById('burger'),sheet=document.getElementById('sheet'),cls=document.getElementById('cls');
  function closeSheet(){sheet.classList.remove('open');document.body.style.overflow=''}
  burger.addEventListener('click',function(){sheet.classList.add('open');document.body.style.overflow='hidden';icons()});
  cls.addEventListener('click',closeSheet);
  sheet.querySelectorAll('a').forEach(function(a){a.addEventListener('click',closeSheet)});
  addEventListener('keydown',function(e){if(e.key==='Escape')closeSheet()});

  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12,rootMargin:'0px 0px -7% 0px'});
  document.querySelectorAll('.rv').forEach(function(el){io.observe(el)});

  var hh=document.getElementById('heroH');
  if(hh){var ho=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){hh.classList.add('drawn');ho.disconnect()}})},{threshold:.5});ho.observe(hh);}

  // A conversa se monta na ordem em que aconteceu. Uma ilustração parada mostra
  // o produto; esta mostra o produto trabalhando.
  var chat=document.getElementById('chat');
  if(chat){
    var falas=[].slice.call(chat.querySelectorAll('.step-in'));
    if(reduce){falas.forEach(function(f){f.classList.add('shown')});chat.classList.add('playing');}
    else{
      var co=new IntersectionObserver(function(es){es.forEach(function(e){
        if(!e.isIntersecting)return;
        co.disconnect();chat.classList.add('playing');
        // 620ms entre uma fala e outra: com cinco balões, um intervalo maior
        // deixaria a conversa terminando depois que a pessoa já rolou a página.
        falas.forEach(function(f,i){setTimeout(function(){
          f.classList.add('shown');
        },380+i*620)});
      })},{threshold:.35});
      co.observe(chat);
    }
  }

  // Os números sobem quando entram em cena. Parados eles são enfeite; subindo,
  // a pessoa lê cada um em vez de passar o olho pela fileira.
  var strip=document.getElementById('strip');
  if(strip){
    var so=new IntersectionObserver(function(es){es.forEach(function(e){
      if(!e.isIntersecting)return;
      so.disconnect();
      strip.querySelectorAll('[data-count]').forEach(function(el){
        var alvo=parseFloat(el.dataset.count),casas=parseInt(el.dataset.decimals||'0',10),suf=el.dataset.suffix||'';
        if(reduce){el.textContent=alvo.toFixed(casas).replace('.',',')+suf;return}
        var t0=null,dur=1400;
        function passo(t){
          if(!t0)t0=t;
          var p=Math.min((t-t0)/dur,1),eased=1-Math.pow(1-p,3);
          el.textContent=(alvo*eased).toFixed(casas).replace('.',',')+suf;
          if(p<1)requestAnimationFrame(passo);
        }
        requestAnimationFrame(passo);
      });
    })},{threshold:.5});
    so.observe(strip);
  }

  // Só uma pergunta aberta por vez: com todas abertas a lista vira um muro e a
  // pessoa perde de vista quantas ainda restam.
  var faq=document.getElementById('faq');
  if(faq){
    var todas=[].slice.call(faq.querySelectorAll('details'));
    todas.forEach(function(d){d.addEventListener('toggle',function(){
      if(!d.open)return;
      todas.forEach(function(o){if(o!==d)o.open=false});
    })});
  }

  // Onde a pessoa está na página, refletido no menu.
  var alvos=[].slice.call(document.querySelectorAll('section[id]'));
  var links={};
  document.querySelectorAll('#nav a').forEach(function(a){links[a.getAttribute('href').slice(1)]=a});
  if(alvos.length){
    var no=new IntersectionObserver(function(es){es.forEach(function(e){
      var a=links[e.target.id];
      if(!a)return;
      if(e.isIntersecting){Object.keys(links).forEach(function(k){links[k].classList.remove('on')});a.classList.add('on');}
    })},{rootMargin:'-45% 0px -50% 0px'});
    alvos.forEach(function(s){no.observe(s)});
  }

  if(matchMedia('(pointer:fine)').matches&&!reduce){
    document.querySelectorAll('.lg').forEach(function(el){el.addEventListener('pointermove',function(ev){var r=el.getBoundingClientRect();el.style.setProperty('--mx',(ev.clientX-r.left)+'px');el.style.setProperty('--my',(ev.clientY-r.top)+'px')})});
  }
  icons();
})();
</script>
</body>
</html>
