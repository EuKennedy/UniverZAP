.bf-bar .p{font-family:var(--disp);font-size:16px;font-weight:800;color:#fff}
.bf-bar i,.bf-bar svg{width:16px;height:16px;vertical-align:-3px}
.bf-cd{display:inline-flex;gap:5px;font-variant-numeric:tabular-nums}
.bf-cd span{display:inline-flex;flex-direction:column;align-items:center;min-width:36px;padding:4px 5px 3px;border-radius:8px;background:rgba(74,222,128,.12);border:1px solid rgba(74,222,128,.3);line-height:1}
.bf-cd strong{font-family:var(--disp);font-size:16px;font-weight:700;color:#fff}
.bf-cd small{margin-top:3px;font-size:9px;letter-spacing:.09em;text-transform:uppercase;opacity:.75}
.bf-go{display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:999px;background:linear-gradient(180deg,#4ADE80,#22C55E);color:#052312;font-weight:700;text-decoration:none;white-space:nowrap;animation:bf-ping 2.4s infinite}
.bf-go:hover{filter:brightness(1.08)}
@keyframes bf-ping{0%{box-shadow:0 0 0 0 rgba(74,222,128,.55)}70%,100%{box-shadow:0 0 0 10px rgba(74,222,128,0)}}
/* Preco riscado: linha vermelha grossa, o sinal universal de "baixou". */
.bf-bar s,.bfx-was s,.price-was s,.vsl-price s{color:#849A8F;text-decoration-thickness:2px;text-decoration-color:#EF4444}
html.has-bf{scroll-padding-top:calc(76px + var(--bf-h,44px))}
html.has-bf .hero{padding-top:calc(clamp(120px,17vw,180px) + var(--bf-h,44px))}
@media (max-width:640px){.bf-bar{font-size:12.5px;padding:8px 12px}.bf-txt{flex-basis:100%}}
/* Tudo que e .bf-only vale so durante a Black: some junto com a barra quando
   o prazo acaba (o JS tira .has-bf do html). O script da barra roda logo no
   header, antes do resto do corpo, entao isto nao pisca no carregamento. */
html:not(.has-bf) .bf-only{display:none!important}
/* Faixas animadas entre secoes. Duas fitas cruzadas em X correndo em sentidos
   opostos. O texto vem repetido 4x e a animacao anda -50%, entao o loop fecha
   sem emenda. Sao decorativas (aria-hidden): a oferta e o prazo estao escritos
   de verdade no bloco da oferta e no card de preco. */
.bfx-band{position:relative;padding:clamp(34px,5vw,64px) 0;overflow:hidden;pointer-events:none}
.bfx-strip{position:relative;width:112vw;margin-left:-6vw;overflow:hidden;font-family:var(--disp);font-weight:800;text-transform:uppercase;letter-spacing:.02em;font-size:clamp(15px,1.9vw,22px);line-height:1}
.bfx-strip.a{z-index:2;transform:rotate(-2.4deg);background:linear-gradient(90deg,#22C55E,#4ADE80 50%,#22C55E);color:#052312;box-shadow:0 18px 40px -18px rgba(34,197,94,.7)}
.bfx-strip.b{z-index:1;transform:rotate(2deg);margin-top:-52px;background:#030806;color:#EAF4EE;border-block:1px solid rgba(74,222,128,.45)}
.bfx-band.one{padding:clamp(22px,3vw,36px) 0}.bfx-band.one .bfx-strip.a{transform:rotate(-1.2deg)}
.bfx-run{display:flex;align-items:center;width:max-content;padding:15px 0;animation:bfx-mq 44s linear infinite}
.bfx-strip.b .bfx-run{animation-direction:reverse;animation-duration:52s}
.bfx-run span{white-space:nowrap;padding:0 22px}
.bfx-run em{font-style:normal;color:#4ADE80}
.bfx-run b{flex:0 0 auto;width:13px;height:13px;background:currentColor;clip-path:polygon(50% 0,61% 39%,100% 50%,61% 61%,50% 100%,39% 61%,0 50%,39% 39%)}
@keyframes bfx-mq{to{transform:translateX(-50%)}}
/* Bloco da oferta: logo depois do video, para ninguem chegar no fim da pagina
