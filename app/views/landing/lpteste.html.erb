<script>
(function(){
  var bar=document.getElementById('bfBar');
  if(!bar)return;
  var end=new Date(bar.dataset.bfEnd).getTime(), root=document.documentElement;
  function pad(n){return n<10?'0'+n:''+n}
  function fit(){root.style.setProperty('--bf-h',bar.offsetHeight+'px')}
  function off(){bar.hidden=true;root.classList.remove('has-bf','bf-urgent');root.style.removeProperty('--bf-h')}
  function tick(){
    var left=end-Date.now();
    /* !(left>0) tambem pega data invalida (NaN): erro de digitacao esconde a
       barra em vez de mostrar "NaN" ao visitante. */
    if(!(left>0)){off();return false}
    var s=Math.floor(left/1000);
    var v={d:pad(Math.floor(s/86400)),h:pad(Math.floor(s%86400/3600)),m:pad(Math.floor(s%3600/60)),s:pad(s%60)};
    root.classList.toggle('bf-urgent',left<864e5);
    /* Os outros cronometros ficam mais abaixo no corpo e ainda nao existem
       quando este script roda, entao a busca e feita a cada segundo. */
    document.querySelectorAll('[data-bf-cd]').forEach(function(cd){
      ['d','h','m','s'].forEach(function(k){var el=cd.querySelector('[data-u="'+k+'"]');if(el)el.textContent=v[k]});
      var sec=cd.querySelector('[data-u="s"]');if(sec)sec.parentNode.className=s%2?'tka':'tkb';
    });
    return true
  }
  if(!tick())return;
  root.classList.add('has-bf');fit();
  addEventListener('resize',fit);addEventListener('load',fit);
  var t=setInterval(function(){if(!tick())clearInterval(t)},1000);
})();
</script>
