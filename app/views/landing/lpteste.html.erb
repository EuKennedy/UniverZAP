.bfx-sec{padding:clamp(8px,2vw,20px) 0}
.bfx-offer{position:relative;overflow:hidden;display:grid;gap:clamp(24px,4vw,44px);grid-template-columns:1fr;align-items:center;padding:clamp(26px,5vw,56px);border-radius:32px;color:#EAF4EE;background:radial-gradient(110% 90% at 0% 0%,rgba(34,197,94,.3),transparent 55%),radial-gradient(90% 80% at 100% 100%,rgba(74,222,128,.16),transparent 60%),linear-gradient(160deg,#04100A,#030806 60%,#071A10);border:1.5px solid rgba(74,222,128,.45);box-shadow:0 40px 100px -40px rgba(34,197,94,.55),inset 0 1px 0 rgba(255,255,255,.08)}
.bfx-offer>*{position:relative;z-index:1;min-width:0}
.bfx-wm{position:absolute;z-index:0;right:-3%;bottom:-6%;font-family:var(--disp);font-weight:800;font-size:clamp(7rem,24vw,19rem);line-height:.8;letter-spacing:-.06em;color:transparent;-webkit-text-stroke:1.5px rgba(74,222,128,.15);pointer-events:none;user-select:none}
