.bfx-now .rs{font-size:.38em;letter-spacing:-.02em;vertical-align:.95em;margin-right:.12em;color:#4ADE80}
.bfx-off{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;justify-content:center;width:clamp(74px,11vw,96px);aspect-ratio:1;border-radius:50%;background:#4ADE80;color:#052312;font-size:clamp(1.15rem,2.2vw,1.5rem);letter-spacing:-.03em;line-height:.95;text-align:center;transform:rotate(-12deg);box-shadow:0 10px 30px -8px rgba(74,222,128,.7)}
.bfx-off small{display:block;margin-top:2px;font-size:.5em;letter-spacing:.08em}
.bfx-inst{font-size:clamp(1.05rem,1.9vw,1.25rem);color:#D8F5E5}
