<script>
window.BUNNY_LIB  = "706484";
window.BUNNY_HOST = "vz-df16a48e-aa1.b-cdn.net";
window.VSL_GUID   = "413f5a7b-de3f-4b16-adeb-c1b90f6106c3";
// VSL nova hospedada no próprio site; quando ela subir na Bunny, basta trocar o VSL_GUID e apagar VSL_SRC.
window.VSL_SRC    = "/landing/univerzap-vsl.mp4?v=3";
window.VSL_POSTER = "/landing/univerzap-vsl-poster.jpg?v=3";
window.TESTIMONIALS = [
  { guid:"c99fce6f-73f4-41a8-9790-99d2e85890ec", name:"Cliente UniverZAP", tag:"depoimento em vídeo" },
  { guid:"033f8812-cc1b-4d98-93c0-66662f27af25", name:"Cliente UniverZAP", tag:"depoimento em vídeo" },
  { guid:"388658a4-c91e-4651-82e1-a4724019915d", name:"Cliente UniverZAP", tag:"depoimento em vídeo" },
  { guid:"9cb99d1a-d879-4ba8-acb0-92cec44493ee", name:"Cliente UniverZAP", tag:"depoimento em vídeo" },
  { guid:"524f4f08-ad4e-44fb-a14f-b5cd5efa841b", name:"Cliente UniverZAP", tag:"depoimento em vídeo" },
  { guid:"bb254562-0ca1-461a-9a8b-a1a3bdaad5eb", name:"Cliente UniverZAP", tag:"depoimento em vídeo" }
];
(function(){
  var root=document.documentElement;
  if(localStorage.getItem('uz-theme')==='light')root.setAttribute('data-theme','light');
  // São dois botões, um no header e outro dentro do menu, porque no celular o
  // do header não cabe. Os dois mexem no mesmo lugar.
  function flip(){
    var light=root.getAttribute('data-theme')==='light';
    if(light){root.removeAttribute('data-theme');localStorage.setItem('uz-theme','dark');}
    else{root.setAttribute('data-theme','light');localStorage.setItem('uz-theme','light');}
  }
  document.querySelectorAll('.theme-tg').forEach(function(tg){tg.addEventListener('click',flip)});
})();
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
<script>
(function(){
  function icons(){try{window.lucide&&lucide.createIcons()}catch(e){}}
  icons();setTimeout(icons,400);

  try{if(window.qrcode){var qr=qrcode(0,'M');qr.addData('https://univerzap.cloud');qr.make();var box=document.getElementById('qrbox');if(box)box.innerHTML=qr.createSvgTag({cellSize:4,margin:1,scalable:true});}}catch(e){}

  var hd=document.getElementById('hd'),last=0;
  addEventListener('scroll',function(){var y=window.scrollY;hd.classList.toggle('stuck',y>28);if(y>last&&y>420)hd.classList.add('hide');else hd.classList.remove('hide');last=y},{passive:true});

  var burger=document.getElementById('burger'),sheet=document.getElementById('sheet'),cls=document.getElementById('cls');
  // Um estado só, lido da classe, para o botão de menu poder abrir e fechar sem
  // que abrir duas vezes deixe o corpo travado.
  function setSheet(open){
    sheet.classList.toggle('open',open);
    sheet.setAttribute('aria-hidden',open?'false':'true');
    burger.setAttribute('aria-expanded',open?'true':'false');
    document.body.style.overflow=open?'hidden':'';
    if(open){icons();requestAnimationFrame(function(){cls.focus()})}
    else if(sheet.contains(document.activeElement))burger.focus();
  }
  function isSheetOpen(){return sheet.classList.contains('open')}
  function closeSheet(){setSheet(false)}
  burger.addEventListener('click',function(){setSheet(!isSheetOpen())});
  cls.addEventListener('click',closeSheet);
  // Clique no fundo, e não em cima de um link, também fecha.
  sheet.addEventListener('click',function(e){if(e.target===sheet)closeSheet()});
  sheet.querySelectorAll('a').forEach(function(a){a.addEventListener('click',closeSheet)});
  addEventListener('keydown',function(e){if(e.key==='Escape'&&isSheetOpen())closeSheet()});
  // O menu cobre a tela inteira, então o Tab não pode escapar para o header que
  // ficou atrás dele.
  sheet.addEventListener('keydown',function(e){
    if(e.key!=='Tab')return;
    var f=sheet.querySelectorAll('a[href],button'),firstEl=f[0],lastEl=f[f.length-1];
    if(e.shiftKey&&document.activeElement===firstEl){e.preventDefault();lastEl.focus()}
    else if(!e.shiftKey&&document.activeElement===lastEl){e.preventDefault();firstEl.focus()}
  });
  // No desktop o botão de menu some. Se a janela crescer com o menu aberto,
  // sobra um corpo travado sem nada na tela para destravá-lo.
  var wide=matchMedia('(min-width:960px)');
  addEventListener('resize',function(){if(wide.matches&&isSheetOpen())closeSheet()},{passive:true});

  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12,rootMargin:'0px 0px -7% 0px'});
  document.querySelectorAll('.rv').forEach(function(el){io.observe(el)});

  var hh=document.getElementById('heroH');
  var ho=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){hh.classList.add('drawn');ho.disconnect()}})},{threshold:.5});
  if(hh)ho.observe(hh);

  var LIB=window.BUNNY_LIB,HOST=window.BUNNY_HOST,T=window.TESTIMONIALS||[];
  var lb=document.getElementById('lb'),inner=document.getElementById('lbInner');
  function open(guid){inner.innerHTML='<iframe src="https://iframe.mediadelivery.net/embed/'+LIB+'/'+guid+'?autoplay=true&preload=true" loading="lazy" allow="autoplay;fullscreen;picture-in-picture" allowfullscreen></iframe>';lb.classList.add('open');document.body.style.overflow='hidden'}
  function closeLb(){lb.classList.remove('open');document.body.style.overflow='';setTimeout(function(){inner.innerHTML=''},320)}
  // Só fecha se estiver aberto: senão um Esc com o menu na tela zerava o
  // overflow do corpo por conta de um lightbox que ninguém abriu.
  if(lb){document.getElementById('lbX').addEventListener('click',closeLb);lb.addEventListener('click',function(e){if(e.target===lb)closeLb()});addEventListener('keydown',function(e){if(e.key==='Escape'&&lb.classList.contains('open'))closeLb()});}

  var VID=window.VSL_GUID,SRC=window.VSL_SRC,vslP=document.getElementById('vslPlayer');
  if(vslP&&(SRC||VID)){vslP.addEventListener('click',function(){
    var f=document.createElement('div');f.className='vsl-frame';
    if(SRC){f.innerHTML='<video src="'+SRC+'" poster="'+(window.VSL_POSTER||'')+'" controls autoplay playsinline preload="auto"></video>';vslP.parentNode.replaceChild(f,vslP);return;}
    f.innerHTML='<iframe src="https://iframe.mediadelivery.net/embed/'+LIB+'/'+VID+'?autoplay=true&preload=true&responsive=true" loading="lazy" allow="autoplay;fullscreen;picture-in-picture;encrypted-media" allowfullscreen></iframe>';
    vslP.parentNode.replaceChild(f,vslP);
  });}

  var track=document.getElementById('rtrack'),dots=document.getElementById('rdots');
  if(track&&T.length){
    var moved=false;
    T.forEach(function(t,idx){
      var ready=t.guid&&HOST;
      var card=document.createElement('button');card.type='button';card.className='rcard';card.setAttribute('aria-label','Ver depoimento '+(idx+1));
      card.innerHTML=(ready?'<img class="rthumb" src="https://'+HOST+'/'+t.guid+'/thumbnail.jpg" alt="" loading="lazy" onerror="this.remove()">':'')+'<span class="rplay"><i data-lucide="play"></i></span><span class="rwho"><b>'+t.name+'</b><small>'+t.tag+'</small></span>';
      card.addEventListener('click',function(){if(moved||!ready)return;open(t.guid)});
      track.appendChild(card);
      var d=document.createElement('button');d.type='button';d.className='rdot';d.setAttribute('aria-label','Ir para depoimento '+(idx+1));d.addEventListener('click',function(){go(idx)});dots.appendChild(d);
    });
    var cards=[].slice.call(track.children),ds=[].slice.call(dots.children);
    function update(){var cx=track.scrollLeft+track.clientWidth/2,best=1e9,act=0;cards.forEach(function(c,i){var cc=c.offsetLeft+c.offsetWidth/2,dist=Math.abs(cc-cx),n=Math.min(dist/c.offsetWidth,1);c.style.setProperty('--s',(1-0.15*n).toFixed(3));c.style.setProperty('--o',(1-0.42*n).toFixed(3));c.classList.toggle('active',n<0.5);if(dist<best){best=dist;act=i}});ds.forEach(function(d,i){d.classList.toggle('on',i===act)})}
    function go(i){var c=cards[i];track.scrollTo({left:c.offsetLeft+c.offsetWidth/2-track.clientWidth/2,behavior:'smooth'})}
    track.addEventListener('scroll',function(){requestAnimationFrame(update)},{passive:true});
    document.getElementById('rPrev').addEventListener('click',function(){track.scrollBy({left:-(cards[0].offsetWidth+18),behavior:'smooth'})});
    document.getElementById('rNext').addEventListener('click',function(){track.scrollBy({left:cards[0].offsetWidth+18,behavior:'smooth'})});
    var down=false,sx=0,sl=0;
    track.addEventListener('pointerdown',function(e){down=true;moved=false;sx=e.clientX;sl=track.scrollLeft;track.style.scrollSnapType='none'});
    track.addEventListener('pointermove',function(e){if(!down)return;var dx=e.clientX-sx;if(Math.abs(dx)>6)moved=true;track.scrollLeft=sl-dx});
    function endDrag(){if(!down)return;down=false;track.style.scrollSnapType='';setTimeout(function(){moved=false},20)}
    track.addEventListener('pointerup',endDrag);track.addEventListener('pointerleave',endDrag);
    addEventListener('resize',update);
    setTimeout(function(){go(Math.floor(T.length/2));setTimeout(update,60)},60);
  }

  if(matchMedia('(pointer:fine)').matches&&!matchMedia('(prefers-reduced-motion:reduce)').matches){
    document.querySelectorAll('.lg').forEach(function(el){el.addEventListener('pointermove',function(ev){var r=el.getBoundingClientRect();el.style.setProperty('--mx',(ev.clientX-r.left)+'px');el.style.setProperty('--my',(ev.clientY-r.top)+'px')})});
  }
  icons();
})();
</script>
