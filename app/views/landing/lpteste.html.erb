.bfx-r{padding:clamp(20px,3vw,30px);border-radius:24px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);text-align:center}
.bfx-lb{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#4ADE80}
.bfx-lb::before{content:"";width:8px;height:8px;border-radius:50%;background:currentColor;animation:bf-dot 1.2s infinite}
@keyframes bf-dot{50%{opacity:.2}}
/* Cronometro grande. Os segundos alternam entre duas animacoes iguais com
   nomes diferentes: trocar o nome e o que faz o navegador rodar de novo. */
.bfx-cd{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(6px,1.2vw,10px);margin-top:14px;font-variant-numeric:tabular-nums}
.bfx-cd span{min-width:0;display:flex;flex-direction:column;align-items:center;padding:clamp(10px,1.6vw,14px) 4px clamp(8px,1.2vw,10px);border-radius:16px;background:linear-gradient(180deg,#0E2A1C,#06140D);border:1px solid rgba(74,222,128,.35);box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 12px 30px -16px rgba(34,197,94,.6);transition:border-color .4s}
.bfx-cd strong{font-family:var(--disp);font-weight:800;font-size:clamp(1.7rem,7.4vw,3.2rem);line-height:1;color:#fff;letter-spacing:-.03em}
.bfx-cd small{margin-top:6px;font-size:10.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#A6BDB2}
.bfx-cd .tka strong{animation:bf-tka .5s var(--ease)}.bfx-cd .tkb strong{animation:bf-tkb .5s var(--ease)}
@keyframes bf-tka{0%{transform:translateY(-7px) scale(1.1);color:#4ADE80}100%{transform:none}}
@keyframes bf-tkb{0%{transform:translateY(-7px) scale(1.1);color:#4ADE80}100%{transform:none}}
.bfx-cd.sm{margin:22px 0 4px}.bfx-cd.sm strong{font-size:clamp(1.6rem,6vw,2rem)}.bfx-cd.sm span{border-radius:13px}
.bfx-when{margin-top:14px;font-size:14px;color:#D8F5E5}
.bfx-when b{color:#fff}
.bfx-cta{width:100%;margin-top:18px}
.bfx-secure{margin-top:12px;font-size:12.5px;color:#A6BDB2}.bfx-secure i,.bfx-secure svg{width:14px;height:14px;vertical-align:-2px}
@media(max-width:479px){.bfx-r{padding:18px 14px}.bfx-cd small{font-size:9.5px;letter-spacing:.08em}}
